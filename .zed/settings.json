{
  "preferred_line_length": 120,
  "languages": {
    "Python": {
      "preferred_line_length": 120,
      "hard_tabs": false,
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": [
        {
          "external": {
            "command": "pixi",
            "arguments": ["run", "-e", "dev", "ruff", "check", "--fix", "--select", "I,F401", "-"]
          }
        },
        {
          "external": {
            "command": "pixi",
            "arguments": ["run", "-e", "dev", "ruff", "format", "-"]
          }
        }
      ]
    }
  }
}
